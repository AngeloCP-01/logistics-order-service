NODE_ENV=development
PORT=3003
LOG_LEVEL=debug
LOG_SERVICE_NAME=order-service

# Postgres (dev compose brings this up on :5436).
ORDER_DB_URL=postgresql://order:order@localhost:5436/order?schema=public

# Verifies INBOUND user JWTs (HS256). order-service never mints user tokens —
# auth-service does. So for an auth-minted token to verify here, this value MUST
# EQUAL auth-service's AUTH_JWT_SECRET. (A one-char mismatch = "invalid token".)
ORDER_JWT_SECRET=change-me-min-32-chars-aaaaaaaaaaaa

# Signs the OUTBOUND service JWT order-service sends to user-service (to resolve
# a dropoff address). user-service verifies it with its USER_SERVICE_JWT_SECRET,
# so this value MUST EQUAL user-service's USER_SERVICE_JWT_SECRET. It must also
# DIFFER from ORDER_JWT_SECRET above (boot refuses to start if they're equal).
SERVICE_JWT_SECRET=change-me-min-32-chars-bbbbbbbbbbbb

# Where order-service resolves the dropoff address. LOCALLY point this straight
# at user-service (its PORT is 3001 — NOT auth-service's 3000). In real deploys
# this is the gateway URL (which routes /v1/users/* to user-service).
ORDER_USER_SERVICE_URL=http://localhost:3001

# Broker. The platform's shared `logistics-rabbitmq` container uses dev/dev
# (NOT the bare-image default guest/guest) — match it or boot fails ACCESS_REFUSED.
RABBITMQ_URL=amqp://dev:dev@localhost:5672
